# Copy to /etc/tijori/tijori.env and `chmod 600` it. Names only here; values never enter git.
# Use URL-safe passwords (e.g. `openssl rand -hex 32`): they are embedded in connection URLs.

# Postgres owner role: migrations and CLI bootstrap only.
TIJORI_OWNER_DB_PASSWORD=
# Runtime role the api and worker connect as (row-level security applies).
TIJORI_APP_DB_PASSWORD=

# Google sign-in (OAuth client of type "Web application"; redirect URI
# {TIJORI_PUBLIC_URL}/auth/callback). The api refuses to start in prod without the pair.
TIJORI_PUBLIC_URL=https://tijori.example.com
TIJORI_OIDC_CLIENT_ID=
TIJORI_OIDC_CLIENT_SECRET=
# Comma-separated emails that may register on first sign-in without an invite.
TIJORI_ALLOWED_EMAILS=

# SecretBox master key for member secrets (app and statement passwords): base64 of 32 random
# bytes, e.g. `openssl rand -base64 32`. The api refuses to start in prod without it.
TIJORI_MASTER_KEY=
# Only while rotating: the previous key; then run `python -m tijori.cli rotate-master-key`.
TIJORI_MASTER_KEY_OLD=

# Optional: deploy notifications (read by deploy/pull-update.sh).
NTFY_URL=
NTFY_OPS_TOKEN=
